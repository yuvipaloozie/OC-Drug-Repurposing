/* ===========================================================================
   Osteoclast Knowledge Graph - Neo4j Browser Style Sheet (GRASS)
   Colors: 8 distinct subtypes with transparent fills & opaque borders
   =========================================================================== */

node {
  diameter: 55px;
  color: #F8FAFC;
  border-color: #64748B;
  border-width: 2px;
  text-color-internal: #1E293B;
  font-size: 10px;
}

relationship {
  color: #94A3B8;
  shaft-width: 2px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #475569;
  text-color-internal: #FFFFFF;
}

/* Protein (Green) */
node.Protein {
  color: #DCFCE7;
  border-color: #16A34A;
  border-width: 3.5px;
  text-color-internal: #15803D;
  caption: "{name}";
}

/* Enzyme (Red) */
node.Enzyme {
  color: #FEE2E2;
  border-color: #DC2626;
  border-width: 3.5px;
  text-color-internal: #B91C1C;
  caption: "{name}";
}

/* Transcription Factor (Magenta) */
node.TranscriptionFactor {
  color: #FAE8FF;
  border-color: #C026D3;
  border-width: 3.5px;
  text-color-internal: #86198F;
  caption: "{name}";
}

/* Gene (Orange) */
node.Gene {
  color: #FFEDD5;
  border-color: #EA580C;
  border-width: 3.5px;
  text-color-internal: #9A3412;
  caption: "{name}";
}

/* Extracellular Compound (Brown) */
node.ExtracellularCompound {
  color: #F5E6D3;
  border-color: #8B4513;
  border-width: 3.5px;
  text-color-internal: #5C2C09;
  caption: "{name}";
}

/* Intracellular Compound (Purple) */
node.IntracellularCompound {
  color: #F3E8FF;
  border-color: #9333EA;
  border-width: 3.5px;
  text-color-internal: #6B21A8;
  caption: "{name}";
}

/* Reaction (Royal Blue) */
node.Reaction {
  color: #DBEAFE;
  border-color: #2563EB;
  border-width: 3.5px;
  text-color-internal: #1E40AF;
  caption: "{name}";
}

/* Pathway (Cyan) */
node.Pathway {
  color: #CFFAFE;
  border-color: #0891B2;
  border-width: 3.5px;
  text-color-internal: #155E75;
  caption: "{name}";
}

relationship.ACTIVATES {
  color: #16A34A;
  shaft-width: 2.5px;
}

relationship.INHIBITS {
  color: #DC2626;
  shaft-width: 2.5px;
}

relationship.PART_OF {
  color: #0891B2;
  shaft-width: 2.5px;
}

relationship.REGULATES {
  color: #9333EA;
  shaft-width: 2.5px;
}

relationship.TRANSLATED_TO {
  color: #EA580C;
  shaft-width: 2.5px;
}

relationship.TRANSPORTS {
  color: #8B4513;
  shaft-width: 2.5px;
}
