MERGE (v:Evidence {evidence_id: "ev:full:e50963561a46707f5899c053"}) SET v = {evidence_id: "ev:full:e50963561a46707f5899c053", edge_id: "edge:full:6a90c23300303a5b075c864b", experiment_id: "exp:full:e50963561a46707f5899c053", source_id: "PMID:30692521", quote_or_location: "TRAIL inhibits RANK signaling and suppresses osteoclast activation via inhibiting lipid raft assembly and TRAF6 recruitment.\n\nHuman osteoclast formation from mononuclear phagocyte precursors involves interactions between members of the tumor necrosis factor (TNF) ligand superfamily and their receptors. Recent evidence indicated that TNF-alpha-related apoptosis-inducing ligand (TRAIL) induces osteoclast differentiation via a TRAF6-dependent signaling pathway; but paradoxically, it inhibits RANK ligand (RANKL)-induced osteoclast differentiation.", claim_summary: "TRAIL suppressed RANKL-induced osteoclast differentiation/activation, and the authors describe this as inhibition of osteoclast activation via lipid raft assembly and TRAF6 recruitment.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:d0f7e650983456a7e2c87307\", \"request_id\": \"request:2c64a3397f96ddf6dcd0d7f5\", \"spans\": [{\"end\": 124, \"passage_index\": 0, \"quote\": \"TRAIL inhibits RANK signaling and suppresses osteoclast activation via inhibiting lipid raft assembly and TRAF6 recruitment.\", \"start\": 0}, {\"end\": 423, \"passage_index\": 1, \"quote\": \"Human osteoclast formation from mononuclear phagocyte precursors involves interactions between members of the tumor necrosis factor (TNF) ligand superfamily and their receptors. Recent evidence indicated that TNF-alpha-related apoptosis-inducing ligand (TRAIL) induces osteoclast differentiation via a TRAF6-dependent signaling pathway; but paradoxically, it inhibits RANK ligand (RANKL)-induced osteoclast differentiation.\", \"start\": 0}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_14/2c64a3397f96ddf6dcd0d7f5.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/30692521/", source_sha256: "bc7f45feff2094cafe4d7abd97e45da136c88bff14019c39c3b9774f92257f6b", evidence_kind: "measurement", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v2. Not expert reviewed. {\"directness\": \"unknown\", \"intervention\": \"TRAIL presence\", \"endpoint\": \"RANKL-induced osteoclast differentiation\"} Uncertainties: The text mixes osteoclast differentiation and osteoclast activation; the exact endpoint for each statement is not fully separable from the abstract alone. | Directness is not established for the inhibitory effect beyond the written description.", legacy_experiment_id: "", legacy_source_records: ""};
