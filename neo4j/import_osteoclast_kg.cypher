MERGE (v:Evidence {evidence_id: "ev:full:a436a698f072389101ee27f6"}) SET v = {evidence_id: "ev:full:a436a698f072389101ee27f6", edge_id: "edge:full:bbee5e3e000b26c05f8709be", experiment_id: "exp:full:a436a698f072389101ee27f6", source_id: "PMID:30692521", quote_or_location: "RANKL stimulation induced recruitment of TRAF6, c-Src, and DAP-12 into lipid rafts.\n\nHowever, the RANKL-induced assembly of lipid raft-associated signaling complexes and TRAF6 recruitment was abolished in the presence of TRAIL. TRAIL-induced dissociation of RANKL-induced lipid raft signaling complexes was reversed by treatment with TRAIL receptor (TRAIL-R) siRNA or an anti-TRAIL-R blocking antibody", claim_summary: "In RANKL-stimulated cells, TRAIL abolished recruitment of TRAF6 into lipid raft-associated signaling complexes; this suppression was reversed by TRAIL-R siRNA or an anti-TRAIL-R blocking antibody.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:bdf51eea034f9dc71315cf12\", \"request_id\": \"request:2c64a3397f96ddf6dcd0d7f5\", \"spans\": [{\"end\": 801, \"passage_index\": 1, \"quote\": \"RANKL stimulation induced recruitment of TRAF6, c-Src, and DAP-12 into lipid rafts.\", \"start\": 718}, {\"end\": 1118, \"passage_index\": 1, \"quote\": \"However, the RANKL-induced assembly of lipid raft-associated signaling complexes and TRAF6 recruitment was abolished in the presence of TRAIL. TRAIL-induced dissociation of RANKL-induced lipid raft signaling complexes was reversed by treatment with TRAIL receptor (TRAIL-R) siRNA or an anti-TRAIL-R blocking antibody\", \"start\": 802}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_14/2c64a3397f96ddf6dcd0d7f5.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/30692521/", source_sha256: "bc7f45feff2094cafe4d7abd97e45da136c88bff14019c39c3b9774f92257f6b", evidence_kind: "measurement", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v3. Not expert reviewed. {\"directness\": \"unknown\", \"intervention\": \"TRAIL presence; TRAIL-R siRNA or anti-TRAIL-R blocking antibody reversed the effect\", \"endpoint\": \"TRAF6 recruitment to lipid raft-associated signaling complexes\"} Uncertainties: The statement combines TRAF6 recruitment with broader lipid raft complex assembly; the claim isolates the TRAF6 recruitment part. | TRAIL-R involvement is stated as reversal by siRNA/antibody, but the exact molecular form of TRAIL-R is not specified in the passage.", legacy_experiment_id: "", legacy_source_records: ""};
