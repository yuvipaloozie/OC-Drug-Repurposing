a256: "0d4cf419bb1c5e88c9e6e4f7fab50808d4ecc32cacbd8c39e3b556540e4b2cbe", evidence_kind: "measurement", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v1. Not expert reviewed. {\"directness\": \"indirect\", \"intervention\": \"IL-22 treatment in co-culture\", \"endpoint\": \"OC differentiation / RANKL induction / PGE2 production\"} Uncertainties: The sentence states a mechanistic chain (IL-22 -> COX-2 -> PGE2 -> RANKL), but the individual intermediate causal edges are not separately tested in the excerpt.", legacy_experiment_id: "", legacy_source_records: ""};
