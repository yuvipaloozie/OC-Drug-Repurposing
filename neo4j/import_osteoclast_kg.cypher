// --- 1. Schema Constraints & Indexes ---
CREATE CONSTRAINT unique_node_id IF NOT EXISTS FOR (n:Node) REQUIRE n.node_id IS UNIQUE;
CREATE INDEX node_name_idx IF NOT EXISTS FOR (n:Node) ON (n.name);
CREATE INDEX node_type_idx IF NOT EXISTS FOR (n:Node) ON (n.type);
CREATE INDEX node_compartment_idx IF NOT EXISTS FOR (n:Node) ON (n.compartment);
CREATE INDEX edge_id_idx IF NOT EXISTS FOR ()-[r:ACTIVATES]-() ON (r.edge_id);
CREATE INDEX edge_inhibits_idx IF NOT EXISTS FOR ()-[r:INHIBITS]-() ON (r.edge_id);

