MERGE (v:Evidence {evidence_id: "ev:full:1a38fd24448cff5a9f368fd4"}) SET v = {evidence_id: "ev:full:1a38fd24448cff5a9f368fd4", edge_id: "edge:full:04c929af4c007b701299bccf", experiment_id: "exp:full:1a38fd24448cff5a9f368fd4", source_id: "PMID:19692574", quote_or_location: "We show here that EKO podosomes are disorganized, unusually stable, and reorganize poorly in response to physical contact. Phosphorylation and activities of Src, Pyk2, and Rac are decreased and Rho activity is increased in EKO osteoclasts, suggesting that integrin signaling is defective in these cells.", claim_summary: "In osteoclasts lacking PTPe, Src phosphorylation/activity is reduced and podosomes are disorganized and unusually stable, consistent with defective integrin signaling.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:c52f49dfaa7174ea74d70e5a\", \"request_id\": \"request:5d483d18d63ea04d0acebe54\", \"spans\": [{\"end\": 641, \"passage_index\": 1, \"quote\": \"We show here that EKO podosomes are disorganized, unusually stable, and reorganize poorly in response to physical contact. Phosphorylation and activities of Src, Pyk2, and Rac are decreased and Rho activity is increased in EKO osteoclasts, suggesting that integrin signaling is defective in these cells.\", \"start\": 338}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_6/5d483d18d63ea04d0acebe54.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/19692574/", source_sha256: "bcc17575c75ea4e5bc4b8b8bc77594b955b6e9e2cf7c897d19e693497e436537", evidence_kind: "measurement", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v1. Not expert reviewed. {\"directness\": \"unknown\", \"intervention\": \"female mice lacking PTPe (EKO mice)\", \"endpoint\": \"Src phosphorylation and activity; podosome organization/stability\"} Uncertainties: The passage reports multiple correlated changes in EKO osteoclasts; the direct causal link between PTPe loss and Src reduction is inferred from perturbation. | The existing-node suggestion for Src appears conflicting with the textual entity PTPe; no node mapping was asserted for PTPe beyond the provider annotation.", legacy_experiment_id: "", legacy_source_records: ""};
