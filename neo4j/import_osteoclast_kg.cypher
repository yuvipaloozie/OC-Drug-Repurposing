MERGE (v:Evidence {evidence_id: "ev:full:c6db11d4f6f69d43f5358dff"}) SET v = {evidence_id: "ev:full:c6db11d4f6f69d43f5358dff", edge_id: "edge:full:bee20447cac777aeca74f28b", experiment_id: "exp:full:c6db11d4f6f69d43f5358dff", source_id: "PMID:41457534", quote_or_location: "Akt and AMPK activation. The bone phenotype of Mkrn1-deficient mice was investigated through bone analysis. This study revealed that Mkrn1 significantly influences RANKL-induced osteoclastogenesis. Overexpression of Mkrn1 in BMMs enhanced osteoclast differentiation by promoting Akt phosphorylation and inhibiting AMPK phosphorylation upon RANKL stimulation. Conversely, siRNA-mediated downregulation of MKRN1 reduced Akt phosphorylation and increased AMPK phosphorylation, impairing osteoclastogenesis.", claim_summary: "siRNA-mediated downregulation of MKRN1 reduced Akt phosphorylation and increased AMPK phosphorylation in BMMs, impairing osteoclastogenesis.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:e4e43fe5a6ebead82d061448\", \"request_id\": \"request:8ad823be1b263f365c857238\", \"spans\": [{\"end\": 1643, \"passage_index\": 1, \"quote\": \"Akt and AMPK activation. The bone phenotype of Mkrn1-deficient mice was investigated through bone analysis. This study revealed that Mkrn1 significantly influences RANKL-induced osteoclastogenesis. Overexpression of Mkrn1 in BMMs enhanced osteoclast differentiation by promoting Akt phosphorylation and inhibiting AMPK phosphorylation upon RANKL stimulation. Conversely, siRNA-mediated downregulation of MKRN1 reduced Akt phosphorylation and increased AMPK phosphorylation, impairing osteoclastogenesis.\", \"start\": 1140}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_6/8ad823be1b263f365c857238.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/41457534/", source_sha256: "6a186ea83958996a38090b8e424c609bc5575fd7526f43541308bcc55326313b", evidence_kind: "measurement", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v1. Not expert reviewed. {\"directness\": \"unknown\", \"intervention\": \"siRNA-mediated downregulation of MKRN1\", \"endpoint\": \"Akt phosphorylation\"} Uncertainties: The text reports phosphorylation changes rather than direct enzymatic activity. | AMPK is mentioned in the same sentence but the regulatory edge extracted here is the MKRN1-to-Akt phosphorylation effect.", legacy_experiment_id: "", legacy_source_records: ""};
