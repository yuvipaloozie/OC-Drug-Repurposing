MERGE (v:Evidence {evidence_id: "ev:full:a28c68662588883fd177c998"}) SET v = {evidence_id: "ev:full:a28c68662588883fd177c998", edge_id: "edge:full:d77631522379b15185ac3c5f", experiment_id: "exp:full:a28c68662588883fd177c998", source_id: "PMID:38655781", quote_or_location: "silencing mTOR mitigated the stimulation of osteoblast and adipocyte differentiation induced by cortactin overexpression. Notably, transplantation of cortactin-silenced bone marrow stromal cells (BMSCs) into the marrow of mice led to a reduction in trabecular bone mass, accompanied by a decrease in osteoblasts and an increase in osteoclasts. Furthermore, cortactin-silenced BMSCs expressed higher levels of RANKL than control BMSCs did, and promoted osteoclast differentiation when cocultured with bone marrow-derived osteoclast precursor cells.", claim_summary: "Cortactin-silenced BMSCs promoted osteoclast differentiation in coculture with bone marrow-derived osteoclast precursor cells.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:2a8c13b181bc149fb4d28422\", \"request_id\": \"request:96128281a2760338ae2d6ad4\", \"spans\": [{\"end\": 1478, \"passage_index\": 1, \"quote\": \"silencing mTOR mitigated the stimulation of osteoblast and adipocyte differentiation induced by cortactin overexpression. Notably, transplantation of cortactin-silenced bone marrow stromal cells (BMSCs) into the marrow of mice led to a reduction in trabecular bone mass, accompanied by a decrease in osteoblasts and an increase in osteoclasts. Furthermore, cortactin-silenced BMSCs expressed higher levels of RANKL than control BMSCs did, and promoted osteoclast differentiation when cocultured with bone marrow-derived osteoclast precursor cells.\", \"start\": 931}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_1/96128281a2760338ae2d6ad4.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/38655781/", source_sha256: "d6bd489f4177c86d3eaaf30ec0c2778f816021df5ff54b5ba524d4d241bf440b", evidence_kind: "perturbation", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v1. Not expert reviewed. {\"directness\": \"indirect\", \"intervention\": \"cortactin-silenced BMSCs\", \"endpoint\": \"osteoclast differentiation\"} Sign is an inferred normal molecular role; genetic perturbation is not equivalent to pharmacological inhibition. Uncertainties: The statement combines coculture results with other in vivo outcomes in the surrounding sentence; the extracted claim is limited to the explicit coculture effect. | The causal mediator is not isolated; the text suggests RANKL involvement but does not prove direct causation for the coculture effect.", legacy_experiment_id: "", legacy_source_records: ""};
