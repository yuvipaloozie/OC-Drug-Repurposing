MERGE (v:Evidence {evidence_id: "ev:full:ce807da271ef677a3e82c118"}) SET v = {evidence_id: "ev:full:ce807da271ef677a3e82c118", edge_id: "edge:full:5f50ee24158546d399b526de", experiment_id: "exp:full:ce807da271ef677a3e82c118", source_id: "PMID:18378693", quote_or_location: "Importantly, PLCgamma2 was found to be required for proper localization of Src to the sealing actin ring, and this function required both its catalytic activity and adapter domains. Based on these results, we propose that PLCgamma2 influences Src activation by mediating the localization of Src to the integrin complex and thereby regulating integrin-mediated functions in the osteoclast.", claim_summary: "PLCgamma2 was required for proper localization of Src to the sealing actin ring in osteoclasts, and the authors state that this function depended on PLCgamma2 catalytic activity and adapter domains.", passage_status: "source_checked_quote", source_location: "{\"claim_id\": \"extracted:578de77185683ffe87c72929\", \"request_id\": \"request:985a6c6cced18e13f00e05e4\", \"spans\": [{\"end\": 1229, \"passage_index\": 1, \"quote\": \"Importantly, PLCgamma2 was found to be required for proper localization of Src to the sealing actin ring, and this function required both its catalytic activity and adapter domains. Based on these results, we propose that PLCgamma2 influences Src activation by mediating the localization of Src to the integrin complex and thereby regulating integrin-mediated functions in the osteoclast.\", \"start\": 841}], \"validation_file\": \"data/staging/full_enrichment_v2/shard_5/985a6c6cced18e13f00e05e4.validation.json\"}", source_url: "https://pubmed.ncbi.nlm.nih.gov/18378693/", source_sha256: "4ec844ac43aa8857ea6ec04d71d80cabdcaaa04387b44924891f6f3518c8573f", evidence_kind: "perturbation", polarity: "support", curator_status: "automated_extraction", reviewed_at: "", review_note: "Automated source-anchored proposal; identity decisions and original uncertainties retained in data/staging/full_integration_v1. Not expert reviewed. {\"directness\": \"unknown\", \"intervention\": \"absence of PLCgamma2\", \"endpoint\": \"Src localization to the sealing actin ring\"} Sign is an inferred normal molecular role; genetic perturbation is not equivalent to pharmacological inhibition. Uncertainties: The sentence mixes an observed requirement with a proposed mechanism; only the requirement for localization is extracted as the observed result. | Directness of the localization effect is not established.", legacy_experiment_id: "", legacy_source_records: ""};
