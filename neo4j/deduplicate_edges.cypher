// ==========================================================================
// Osteoclast Mini-PrimeKG Edge Deduplication & Evidence Consolidation
// Consolidates 16 redundant multi-edge pairs with same response into 1 edge
// ==========================================================================

MATCH (s)-[r]->(t) WHERE (s.id IN ['HGNC:IKBKB', 'IKBKB'] OR s.node_id IN ['HGNC:IKBKB', 'IKBKB'])   AND (t.id IN ['HGNC:NFKB1', 'NFKB1'] OR t.node_id IN ['HGNC:NFKB1', 'NFKB1']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:kim_01", "kind": "measurement; perturbation", "polarity": "support", "quote_or_description": "IKK complex activation phosphorylates IkB leading to p50/p65 NF-kB nuclear entry. IKK activation releases p50 to form transcriptionally active RelA/p50 heterodimers. [Confirmed by STRING v12.0 mouse PPI: score=0.997, escore=0.659]", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": true}', rels[0].source_record_id = 'PMID:16339965; PMID:kim_01' FOREACH (dup IN rels[1..] | DELETE dup);
MATCH (s)-[r]->(t) WHERE (s.id IN ['HGNC:TYROBP', 'TYROBP'] OR s.node_id IN ['HGNC:TYROBP', 'TYROBP'])   AND (t.id IN ['HGNC:SYK', 'SYK'] OR t.node_id IN ['HGNC:SYK', 'SYK']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:koga_04", "kind": "association; perturbation", "polarity": "support", "quote_or_description": "Canonical signaling transduction step: HGNC:TYROBP activates HGNC:SYK reported in PMID:16339965. Phosphorylated DAP12 ITAM recruits and activates Syk kinase. [Confirmed by STRING v12.0 mouse PPI: score=0.999, escore=0.736]", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": true}', rels[0].source_record_id = 'PMID:16339965; PMID:koga_04' FOREACH (dup IN rels[1..] | DELETE dup);
MATCH (s)-[r]->(t) WHERE (s.id IN ['HGNC:SYK', 'SYK'] OR s.node_id IN ['HGNC:SYK', 'SYK'])   AND (t.id IN ['HGNC:PLCG2', 'PLCG2'] OR t.node_id IN ['HGNC:PLCG2', 'PLCG2']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:koga_04", "kind": "association; perturbation", "polarity": "support", "quote_or_description": "Canonical signaling transduction step: HGNC:SYK activates HGNC:PLCG2 reported in PMID:16339965. Syk phosphorylates and activates PLC-gamma-2. [Confirmed by STRING v12.0 mouse PPI: score=0.999, escore=0.556]", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": true}', rels[0].source_record_id = 'PMID:16339965; PMID:koga_04' FOREACH (dup IN rels[1..] | DELETE dup);
MATCH (s)-[r]->(t) WHERE (s.id IN ['HGNC:BTK', 'BTK'] OR s.node_id IN ['HGNC:BTK', 'BTK'])   AND (t.id IN ['HGNC:PLCG2', 'PLCG2'] OR t.node_id IN ['HGNC:PLCG2', 'PLCG2']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:koga_04", "kind": "association; perturbation", "polarity": "support", "quote_or_description": "Canonical signaling transduction step: HGNC:BTK activates HGNC:PLCG2 reported in PMID:16339965. BTK phosphorylates PLC-gamma-2 at Tyr753/759. [Confirmed by STRING v12.0 mouse PPI: score=0.999, escore=0.168]", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": true}', rels[0].source_record_id = 'PMID:16339965; PMID:koga_04' FOREACH (dup IN rels[1..] | DELETE dup);
MATCH (s)-[r]->(t) WHERE (s.id IN ['HGNC:TET2', 'TET2'] OR s.node_id IN ['HGNC:TET2', 'TET2'])   AND (t.id IN ['RXN:CHROMATIN_TET2_5hmC_hydroxymethylation', 'CHROMATIN_TET2_5hmC_hydroxymethylation'] OR t.node_id IN ['RXN:CHROMATIN_TET2_5hmC_hydroxymethylation', 'CHROMATIN_TET2_5hmC_hydroxymethylation']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:rong_01; exp:stegen_01", "kind": "measurement; perturbation", "polarity": "support", "quote_or_description": "TET2 mediates 5hmC deposition at pro-osteoclastogenic enhancer elements. TET2 catalyzes conversion of 5mC to 5hmC at osteoclast enhancer elements.", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": false}', rels[0].source_record_id = 'DOI:10.1038/s41413-025-00437-w; PMID:stegen_01' FOREACH (dup IN rels[1..] | DELETE dup);
