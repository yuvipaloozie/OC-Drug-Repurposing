MATCH (s)-[r]->(t) WHERE (s.id IN ['GENE:Dcstamp', 'Dcstamp'] OR s.node_id IN ['GENE:Dcstamp', 'Dcstamp'])   AND (t.id IN ['HGNC:DCSTAMP', 'DCSTAMP'] OR t.node_id IN ['HGNC:DCSTAMP', 'DCSTAMP']) WITH s, t, collect(r) AS rels WHERE size(rels) > 1 SET rels[0].evidence = '{"experiment_id": "exp:yagi_01", "kind": "association; perturbation", "polarity": "support", "quote_or_description": "Canonical signaling transduction step: MRNA:Dcstamp translated_to HGNC:DCSTAMP reported in PMID:16061724. Dcstamp mRNA is translated into seven-transmembrane DC-STAMP protein.", "curator_status": "reviewed", "reviewed_at": "2026-09-28", "string_ppi_validated": false}', rels[0].source_record_id = 'PMID:16061724; PMID:yagi_01' FOREACH (dup IN rels[1..] | DELETE dup);
