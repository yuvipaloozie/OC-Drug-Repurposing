# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Large or raw data files (manifest tracks provenance)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
background/
models/checkpoints/
*.pt
*.pth
*.ckpt

# Cloned benchmark repositories and local backups
benchmarks/
data/processed/backup_legacy_schema/

# Reviewed source snapshots are required for reproducible evidence audits.
!data/raw/provenance/
!data/raw/provenance/**
