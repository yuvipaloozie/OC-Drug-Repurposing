# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Large or raw data files (manifest tracks provenance)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
background/
models/checkpoints/
*.pt
*.pth
*.ckpt

# Cloned benchmark repositories and local backups
benchmarks/
data/processed/backup_legacy_schema/

# Reviewed source snapshots are required for reproducible evidence audits.
!data/raw/provenance/
!data/raw/provenance/**

# Bounded discovery snapshot supports offline replay and source auditing.
!data/raw/discovery_pilot/
!data/raw/discovery_pilot/**

# Local credentials: never commit secrets, including provider-specific dotenv files.
.env.*
!.env.example
.secrets/
credentials.local.json
*.dpapi

# Regenerable review pages, execution logs, and superseded drafts.
data/staging/**/*.log
data/staging/**/review_queue.html
data/staging/**/test_results.txt
data/staging/**/*draft*
data/staging/**/*rolled_back*
data/staging/**/*superseded*
data/staging/**/initial_prepared_superseded.json

# Provider response envelopes contain opaque encrypted payloads; retain locally only.
data/staging/**/*.response.json
# Large discovery intermediates are regenerated from the retained public-source cache.
data/staging/**/annotated_documents.json
data/staging/connectivity_1000/
data/staging/connectivity_iteration_1/
