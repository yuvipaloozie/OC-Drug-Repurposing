          "assay": "micro-CT small animal in vivo imaging system and staining methods",
          "dose": "1.5 mg kg-1",
          "duration": "120 consecutive days",
          "endpoint": "bone mineral density",
          "intervention": "prophylactic administration of alpha-ZAL (1.5 mg kg-1) every 3 days for 120 consecutive days",
          "outcome_change": "increased",
          "perturbation_type": "chemical_treatment"
